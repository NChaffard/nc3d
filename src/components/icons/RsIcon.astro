---
import InstaIcon from "../../assets/icons/insta.svg";
import FbIcon from "../../assets/icons/facebook.svg";
import YtIcon from "../../assets/icons/youtube.svg";
import MailIcon from "../../assets/icons/mail.svg";

interface Props {
  icon?: "insta" | "fb" | "yt" | "mail";
  class?: string;
}
const { icon = "insta", class: className }: Props = Astro.props;

const iconMap = {
  insta: InstaIcon,
  fb: FbIcon,
  yt: YtIcon,
  mail: MailIcon,
} as const;
const Icon = iconMap[icon];

const linkMap = {
  insta: "https://www.instagram.com/nc3dworkshop/",
  fb: "#",
  yt: "https://www.youtube.com/@NC3DShop/shorts",
  mail: "#",
} as const;
const link = linkMap[icon];

const labelMap = {
  insta: "Lien vers ma page Instagram",
  fb: "Lien vers ma page Facebbok",
  yt: "Lien vers ma page Youtube",
  mail: "Lien pour m'envoyer un mail",
} as const;
const label = labelMap[icon];
---

<a href={link} aria-label={label}>
  <Icon class:list={["fill-amber-50 hover:duration-500", className]} />
</a>
