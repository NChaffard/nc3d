---
import RsIcon from "../icons/RsIcon.astro";
---

<footer class="h-30 mt-10 bg-gray-900">
  <nav class="h-full">
    <ul class="h-full w-full grid grid-cols-3 grid-rows-2">
      <li class="flex justify-center items-center h-full">
        <RsIcon icon="yt" class="hover:fill-amber-700" />
      </li>
      <li class="flex justify-center items-center h-full">
        <RsIcon icon="insta" class="hover:fill-fuchsia-700" />
      </li>
      <li class="flex justify-center items-center h-full">
        <RsIcon icon="mail" class="hover:fill-amber-200" />
      </li>
      <li
        class="col-span-3 flex justify-center items-center mx-4 border-amber-50 border-t"
      >
        <a
          class="text-amber-50 text-xl text-center px-auto hover:underline"
          href="/mentions-legales">Mentions légales</a
        >
      </li>
    </ul>
  </nav>
</footer>
