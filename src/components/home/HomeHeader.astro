---
import Image from "astro/components/Image.astro";
import HeaderImage from "../../assets/header/placeholder.jpg";
import Logo from "../../assets/icons/nc3d.svg";
---

<header class="">
  <div class="w-full md:h-120">
    <Image
      src={HeaderImage}
      alt="Figurine imprimée en 3D"
      width={1300}
      class="object-cover h-full"
    />
  </div>
  <div class="h-80 flex flex-col items-center">
    <Logo width={150} height={150} />
    <div class="flex flex-col items-center">
      <h1 class="site-title">NC3D</h1>
      <h2 class="site-subtitle">Fabrication d'objets de décoration</h2>
    </div>
  </div>
</header>
